{
  "name": "@coded-design/dom-battlefield",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "description": "A separate DOM battlefield and squad tactics app, powered by Sherman Bytes artwork.",
  "license": "MIT",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node --expose-gc --import tsx --test --test-concurrency=1 tests/*.test.mjs",
    "build": "npm run typecheck && vite build && node scripts/build-manifest.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "size": "node scripts/size.mjs",
    "test:browser": "node tests/browser.mjs && node tests/a11y.mjs",
    "site:dev": "astro dev --config site/astro.config.mjs",
    "site:build": "astro build --config site/astro.config.mjs && node scripts/pages.mjs",
    "test:site": "node tests/site.mjs && node tests/archive.mjs",
    "sync:archive": "node scripts/sync-archive.mjs",
    "shots": "node scripts/shots.mjs"
  },
  "devDependencies": {
    "astro": "7.4.2",
    "playwright": "1.58.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
