---
// Board UI style guide: the game board and controls design system, shown live. Every demo is
// built from fizlet/ui (vendor/fizlet/ui: board-ui.css + board-ui.ts) only, the kit new boards use, so this page can't
// drift from the kit. The palette switcher passes a palette in, exactly as a game or an embed would.
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { REPO, base, abs } from '../../site';
import { pageLd } from '../../schema.mjs';
const title = 'Board UI · DOM Battlefield style guide';
const description = 'The game board and controls design system behind DOM Battlefield: 3D keys, cards, overlays, launch bursts, layouts and motion, shown live. Only the palette changes from game to game.';
const repo = 'https://github.com/coded-dot-design/fizlet/blob/main/src/ui';
const sections = [
  ['principles', 'Principles'], ['palette', 'Palette'], ['key', 'The 3D key'], ['families', 'Key families'], ['labels', 'Labels'],
  ['cards', 'Cards'], ['overlays', 'Overlays'], ['launch', 'Launch'], ['comms', 'Comms & tips'], ['layouts', 'Layouts'], ['motion', 'Motion & sound'], ['build', 'Build a board'],
];
const principles = [
  ['3D keys', 'Everything you can press is a face over a hard base straight below it. Never a side shadow on the board.'],
  ['One travel', 'Face and base move together on one curve: 120ms ease-out, 50ms on press. Nothing snaps.'],
  ['Colour is the job', 'One colour per job, the same on desktop and phone, dark and light.'],
  ['Locked reads down', 'On rests pressed in the lock colour and breathes. Tap again to release.'],
  ['Call reads up', 'The next key to press stays up and sends a ring from the bottom of its base.'],
  ['The ink rim', 'Keys, stickers and cards share one ink rim in both themes: neon caps on ink.'],
  ['Short, loud words', 'Mono caps. FIRST WORD bold · detail. Explanations go to the comms toast.'],
  ['Overlay ritual', 'Grey dim, a sticker that slams and presses in, two keys at the map’s bottom.'],
  ['The field first', 'Cards move away from your team, shrink to a key and never cover each other.'],
  ['Embed-safe, small', 'One root class, one AbortSignal, reduced motion respected, a budget in CI.'],
];
const roles = [
  ['sys', '--k-sys', 'Navigation, camera, pager, tips, focus'],
  ['cmd', '--k-cmd', 'Command, planning, every locked order'],
  ['fire', '--k-fire', 'The main action'],
  ['aim', '--k-aim', 'Aim modes, dim when off'],
  ['attack', '--k-attack', 'Offensive order'],
  ['advance', '--k-advance', 'Push to objective'],
  ['fallin', '--k-fallin', 'Form up on the player'],
  ['flag', '--k-flag', 'White flag: pause, surrender'],
  ['go', '--k-go', 'Start and confirm'],
  ['teamA', '--team-a', 'Side A (retreat = your team)'],
  ['teamB', '--team-b', 'Side B'],
];
const palettes = {
  battlefield: {},
  swarm: { sys: '#06c4ff', cmd: '#8573ee', fire: '#f4457a', aim: '#ff8fb0', attack: '#e83fd0', advance: '#ffc94a', fallin: '#4bce82', go: '#4bce82', teamA: '#06c4ff', teamB: '#f4457a' },
  sherman: { sys: '#ffc94a', cmd: '#ee6875', fire: '#ff5a36', aim: '#ff9a7a', attack: '#ff3d6e', advance: '#ffb01f', fallin: '#c6f24a', go: '#7cf0a4', teamA: '#7cf0a4', teamB: '#ee6875' },
};
const motion = [
  ['Key travel', '120ms ease-out · press 50ms', 'transform + box-shadow together'],
  ['Locked breath', '1.8s ease-in-out ∞', 'glow ring in the lock colour'],
  ['Call ring', '1.4s ease-out ∞', 'from the bottom of the base'],
  ['Sticker slam', '1100ms', 'drop · hit 36% · settle · hold · press in'],
  ['Launch burst', '760ms', 'press + invert 90ms · 6 chunks · flash · ring · 12 bits'],
  ['Surrender', '16 × 18ms + wave 120ms × 4', 'white-out, then the burst at 480ms'],
  ['Boot doors', '620ms after 120ms', 'rotateY ±100°; the boot runs from t0 = 0.65s'],
  ['Pop-ins', '380ms spring', 'cubic-bezier(.34,1.7,.5,1), never on key travel'],
];
const sounds = [['start', 'two rising notes'], ['fire', 'short zap'], ['hit', 'square thud'], ['hurt', 'saw drop (surrender press)'], ['won', 'three notes up'], ['gameover', 'the end cue']];
const icon = {
  fallin: 'M10 3v6M6 6l4 4 4-4M4 13h12M7 17h6', retreat: 'M3 10 10 4l7 6M5 9v7h10V9M8 16v-4h4v4', advance: 'M4 5l5 5-5 5M10 5l5 5-5 5',
  attack: 'M12 4c2 0 4 2 4 4l-6 6-4-4 6-6ZM6 10l-2 4 2 2 4-2M5 15l-2 2', command: 'M4 8.5 10 4l6 4.5M4 13.5 10 9l6 4.5', flag: 'M5 18V3M5 4h10l-3 3.5 3 3.5H5',
  auto: 'M10 1v4M10 15v4M1 10h4M15 10h4M4 4l2.5 2.5M13.5 13.5 16 16M4 16l2.5-2.5M13.5 6.5 16 4', lock: 'M3 7V3h4M13 3h4v4M17 13v4h-4M7 17H3v-4M10 7v6M7 10h6',
  menu: 'M4 5h12M4 10h12M4 15h12', back: 'M12 4 6 10l6 6', next: 'm8 4 6 6-6 6', list: 'M4 5h12M4 10h7M4 15h12', fire: 'M10 1v5M10 14v5M1 10h5M14 10h5',
};
// A top-down pixel tank in the team colour (treads, hull, turret, barrel up).
const tank = '<rect x="0" y="6" width="3" height="14" fill="var(--rim)"/><rect x="11" y="6" width="3" height="14" fill="var(--rim)"/><rect x="2" y="7" width="10" height="12" fill="var(--team)"/><rect x="4" y="10" width="6" height="6" fill="var(--rim)" opacity=".35"/><rect x="6" y="0" width="2" height="10" fill="var(--team)"/>';
const skull = 'M19 6h26v6h7v6h6v6h5v22h-5v6h-8v12h-9v-8h-6v8h-8v-8h-6v8h-8V52H5v-6H0V24h5v-6h6v-6h8ZM11 29v14h15V29Zm26 0v14h15V29Z';
const cells = Array.from({ length: 16 }, (_, i) => ({ x: (i % 4) * 16, y: Math.floor(i / 4) * 16, i: [0, 1, 4, 2, 5, 8, 3, 6, 9, 12, 7, 10, 13, 11, 14, 15].indexOf(i) }));
---
<Base title={title} description={description} page="style" jsonld={pageLd({ url: abs('style-guide/', Astro.site), name: title, description, home: abs('', Astro.site), site: 'DOM Battlefield', aboutGame: false, crumbs: [['DOM Battlefield', abs('', Astro.site)], ['Style guide', abs('style-guide/', Astro.site)]] })}>

<section class="board-guide" aria-labelledby="bu-title">
  <header class="bu-hero">
    <div class="eyebrow"><span class="index">BUI</span> GAME BOARD DESIGN SYSTEM</div>
    <h1 id="bu-title">One board UI.<br/><em>Every game.</em></h1>
    <p class="lead">The keys, cards, overlays, bursts and layouts we dialled in on DOM Battlefield, made portable. A new board reuses all of it exactly. The only thing a game changes is its palette.</p>
    <div class="bu-links">
      <a class="bui-key bui-arcade bui-cmd" href={`${repo}/BOARD-UI.md`}><Icon name="book" size={18}/>Read the spec</a>
      <a class="bui-key bui-arcade bui-sys" href={`${repo}/tokens.json`}><Icon name="grid" size={18}/>tokens.json</a>
      <a class="bui-key bui-arcade bui-go" href={base('play/')}><Icon name="play" size={18}/>Play DOM Battlefield</a>
    </div>
    <nav class="bu-toc" aria-label="Board UI sections">{sections.map(([id, label], i) => <a href={`#${id}`}><b>{String(i + 1).padStart(2, '0')}</b>{label}</a>)}</nav>
  </header>

  <!-- The control strip: every demo on the page follows it (palette, board theme). -->
  <div class="bu-strip panel" role="group" aria-label="Board demo settings">
    <span class="bu-strip-label">PALETTE</span>
    <div class="bui-seg bu-chips" data-palettes={JSON.stringify(palettes)}>
      <button type="button" data-palette="battlefield" aria-pressed="true">Battlefield</button>
      <button type="button" data-palette="swarm" aria-pressed="false">Swarm</button>
      <button type="button" data-palette="sherman" aria-pressed="false">Sherman</button>
      <button type="button" data-palette="custom" aria-pressed="false">Custom</button>
    </div>
    <span class="bu-strip-label">BOARD</span>
    <div class="bui-seg bu-chips"><button type="button" data-board-theme="dark" aria-pressed="true">Dark</button><button type="button" data-board-theme="light" aria-pressed="false">Light</button><button type="button" data-board-side aria-pressed="false">Side B</button></div>
    <div class="bu-custom" hidden>
      {['sys', 'cmd', 'fire', 'teamA', 'teamB'].map((k) => <label><input type="color" data-custom={k} aria-label={`${k} colour`}/><span>{k}</span></label>)}
    </div>
  </div>

  <!-- 01 PRINCIPLES -->
  <section id="principles" class="bu-block">
    <div class="bu-head"><span class="eyebrow"><span class="index">01</span> PRINCIPLES</span><h2>Ten rules. No exceptions.</h2><p>Everything else on this page follows from these. If a board needs something new, it goes in the spec first.</p></div>
    <ol class="bu-rules">{principles.map(([t, b], i) => <li class="panel"><b>{String(i + 1).padStart(2, '0')}</b><h3>{t}</h3><p>{b}</p></li>)}</ol>
  </section>

  <!-- 02 PALETTE -->
  <section id="palette" class="bu-block">
    <div class="bu-head"><span class="eyebrow"><span class="index">02</span> PALETTE</span><h2>The only thing a game changes.</h2><p>One colour per job. Pass any subset as hex; the rest keep their defaults, and every base, glow and lock colour is derived. Try the switcher above: every demo on this page repaints.</p></div>
    <div class="bui bu-board" data-bui>
      <ul class="bu-roles">{roles.map(([key, name, job]) => <li><i style={`background:var(${name})`}></i><b>{key}</b><code>{name}</code><span>{job}</span><em data-hex={name}></em></li>)}</ul>
    </div>
    <pre class="bu-code"><code>{`import { applyPalette } from "fizlet/ui";
applyPalette(boardRoot, { sys: "#06c4ff", cmd: "#8573ee", teamA: "#4bce82", teamB: "#f4457a" });
// or in an embed config: palette: { cmd: "#8573ee" }   (hex only; anything else is ignored)`}</code></pre>
  </section>

  <!-- 03 THE KEY -->
  <section id="key" class="bu-block">
    <div class="bu-head"><span class="eyebrow"><span class="index">03</span> THE 3D KEY</span><h2>A face over its own base.</h2><p>Families only set variables (<code>--c</code>, <code>--py</code>, <code>--lock</code>); the state rules do all the motion. Press them: they are the real thing.</p></div>
    <div class="bui bu-board" data-bui>
      <div class="bu-states">
        <figure><button class="bui-key bui-arcade bui-fallin" type="button"><svg viewBox="0 0 20 20"><path d={icon.fallin}/></svg>Fall in<kbd>F</kbd></button><figcaption><b>Rest</b>base --py below</figcaption></figure>
        <figure><button class="bui-key bui-arcade bui-fallin bu-hover" type="button" tabindex="-1"><svg viewBox="0 0 20 20"><path d={icon.fallin}/></svg>Fall in<kbd>F</kbd></button><figcaption><b>Hover</b>lift --hy (fine pointers)</figcaption></figure>
        <figure><button class="bui-key bui-arcade bui-fallin down" type="button" tabindex="-1"><svg viewBox="0 0 20 20"><path d={icon.fallin}/></svg>Fall in<kbd>F</kbd></button><figcaption><b>Press</b>face onto the base</figcaption></figure>
        <figure><button class="bui-key bui-arcade bui-fallin" type="button" aria-pressed="true" tabindex="-1"><svg viewBox="0 0 20 20"><path d={icon.fallin}/></svg>Fall in<kbd>F</kbd></button><figcaption><b>Locked</b>down, lock colour, breath</figcaption></figure>
        <figure><button class="bui-key bui-arcade bui-go bui-call" type="button" tabindex="-1"><svg viewBox="0 0 20 20"><path d={icon.next}/></svg>Next<kbd>N</kbd></button><figcaption><b>Call</b>ring from the base</figcaption></figure>
        <figure><button class="bui-key bui-arcade bui-fallin" type="button" disabled><svg viewBox="0 0 20 20"><path d={icon.fallin}/></svg>Fall in<kbd>F</kbd></button><figcaption><b>Disabled</b>flat, 45%</figcaption></figure>
        <figure><button class="bui-key bui-arcade bui-fallin bu-focus" type="button" tabindex="-1"><svg viewBox="0 0 20 20"><path d={icon.fallin}/></svg>Fall in<kbd>F</kbd></button><figcaption><b>Focus</b>ring wraps the base</figcaption></figure>
      </div>
      <div class="bu-try"><span class="bui-label"><b>TRY</b> · tap to lock, tap again to release</span><button class="bui-key bui-arcade bui-cmd" type="button" aria-pressed="false" data-toggle><svg viewBox="0 0 20 20"><path d={icon.command}/></svg>Command<kbd>O</kbd></button></div>
    </div>
    <div class="bu-table panel"><table><thead><tr><th>Variable</th><th>Base</th><th>Arcade</th><th>Sticker</th><th>Meaning</th></tr></thead><tbody>
      <tr><td><code>--py</code></td><td>3u</td><td>4u</td><td>5u</td><td>base height</td></tr>
      <tr><td><code>--hy</code></td><td>1u</td><td>2u</td><td>2u</td><td>hover lift</td></tr>
      <tr><td><code>--edge</code></td><td>--line</td><td>--c 45% into rim</td><td>#f6f3ff</td><td>base colour</td></tr>
      <tr><td><code>--lock</code></td><td></td><td>role or --k-cmd</td><td></td><td>colour when locked</td></tr>
    </tbody></table></div>
  </section>

  <!-- 04 FAMILIES -->
  <section id="families" class="bu-block">
    <div class="bu-head"><span class="eyebrow"><span class="index">04</span> KEY FAMILIES</span><h2>One family, many jobs.</h2><p>Orders lock in the command colour. Aim keys rest dim and light up when on. The shortcut always sits on the right edge.</p></div>
    <div class="bui bu-board" data-bui>
      <div class="bu-row"><span class="bui-label"><b>ORDERS</b> · fall in · retreat · advance · attack</span>
        <div class="bu-keys">
          <button class="bui-key bui-arcade bui-fallin" type="button" aria-pressed="false" data-toggle><svg viewBox="0 0 20 20"><path d={icon.fallin}/></svg>Fall in<kbd>F</kbd></button>
          <button class="bui-key bui-arcade bui-retreat" type="button" aria-pressed="false" data-toggle><svg viewBox="0 0 20 20"><path d={icon.retreat}/></svg>Retreat<kbd>R</kbd></button>
          <button class="bui-key bui-arcade bui-advance" type="button" aria-pressed="false" data-toggle><svg viewBox="0 0 20 20"><path d={icon.advance}/></svg>Advance<kbd>E</kbd></button>
          <button class="bui-key bui-arcade bui-attack" type="button" aria-pressed="false" data-toggle><svg viewBox="0 0 20 20"><path d={icon.attack}/></svg>Attack<kbd>G</kbd></button>
        </div></div>
      <div class="bu-row"><span class="bui-label"><b>AIM</b> · auto / lock · and the flag</span>
        <div class="bu-keys">
          <button class="bui-key bui-arcade bui-aim" type="button" aria-pressed="true" data-toggle><svg viewBox="0 0 20 20"><path d={icon.auto}/></svg>Auto<kbd>Q</kbd></button>
          <button class="bui-key bui-arcade bui-aim" type="button" aria-pressed="false" data-toggle><svg viewBox="0 0 20 20"><path d={icon.lock}/></svg>Lock<kbd>T</kbd></button>
          <button class="bui-key bui-arcade bui-flag" type="button"><svg viewBox="0 0 20 20"><path d={icon.flag}/></svg>Surrender</button>
          <button class="bui-key bui-arcade bui-fire" type="button"><svg viewBox="0 0 20 20"><path d={icon.fire}/><circle cx="10" cy="10" r="5"/></svg>Fire<kbd>Space</kbd></button>
          <button class="bui-key bui-arcade bui-sys" type="button" aria-label="Menu"><svg viewBox="0 0 20 20"><path d={icon.menu}/></svg></button>
        </div></div>
      <div class="bu-row"><span class="bui-label"><b>PLATOON</b> · radios · health · lost</span>
        <div class="bu-keys">
          <button class="bui-key bui-arcade bui-unit active" type="button"><b>★</b><span class="bui-pips"><s></s><s></s></span></button>
          <button class="bui-key bui-arcade bui-unit" type="button"><b>1</b><span class="bui-pips"><s></s><s></s><s></s></span></button>
          <button class="bui-key bui-arcade bui-unit" type="button" data-hp="hurt"><b>2</b><span class="bui-pips"><s></s></span></button>
          <button class="bui-key bui-arcade bui-unit" type="button" data-hp="critical"><b>3</b><span class="bui-pips"><s></s><s></s></span></button>
          <button class="bui-key bui-arcade bui-unit" type="button" disabled><b>4</b><span class="bui-pips"><s></s></span></button>
        </div></div>
      <div class="bu-row"><span class="bui-label"><b>NAVIGATION</b> · pager · segmented · icon keys</span>
        <div class="bu-keys">
          <span class="bui-pager"><button class="bui-key bui-arcade" type="button" aria-label="Previous"><svg viewBox="0 0 20 20"><path d={icon.back}/></svg></button><button class="bui-key bui-arcade" type="button" aria-label="You" aria-pressed="true">★</button><button class="bui-key bui-arcade bui-call" type="button" aria-label="Next"><svg viewBox="0 0 20 20"><path d={icon.next}/></svg></button></span>
          <span class="bui-seg" role="group" aria-label="Density" data-seg><button type="button" aria-pressed="true">Light</button><button type="button" aria-pressed="false">Normal</button><button type="button" aria-pressed="false">Heavy</button></span>
          <button class="bui-key bui-icon-key" type="button" aria-label="Menu"><svg viewBox="0 0 20 20"><path d={icon.menu}/></svg></button>
        </div></div>
      <div class="bu-row"><span class="bui-label"><b>PLANNING</b> · round step keys · count badge · caption</span>
        <div class="bu-keys bu-orbs">
          <button class="bui-orb" type="button" aria-label="Platoon"><svg class="bui-outline" viewBox="0 0 48 36" shape-rendering="crispEdges" style="stroke:none">{[[18,0],[4,16],[32,16]].map(([x,y]) => <g transform={`translate(${x} ${y})`} set:html={tank}/>)}</svg><span class="bui-badge">4</span></button>
          <button class="bui-orb" type="button" aria-label="Previous step"><svg class="bui-outline" viewBox="0 0 48 36" shape-rendering="crispEdges" style="stroke:none;translate:0 -6px"><g transform="translate(4 8)" set:html={tank}/><rect x="24" y="8" width="10" height="4" fill="var(--k-sys)"/><rect x="24" y="16" width="16" height="4" fill="var(--k-sys)"/><rect x="24" y="24" width="20" height="4" fill="var(--k-sys)"/></svg><small>‹ PREV</small><span class="bui-badge">12</span></button>
        </div></div>
    </div>
  </section>

  <!-- 05 LABELS -->
  <section id="labels" class="bu-block">
    <div class="bu-head"><span class="eyebrow"><span class="index">05</span> LABELS</span><h2>FIRST WORD bold · detail.</h2><p>Mono caps, spaced, muted, with the first word in ink. Each layout keeps the same grammar at its own length.</p></div>
    <div class="bu-table panel"><table><thead><tr><th>Group</th><th>Desktop bar</th><th>Compact desktop</th><th>Full-screen card</th><th>Phone</th></tr></thead><tbody>
      <tr><td>per unit</td><td><b>RADIO</b> · EACH TANK</td><td><b>RADIO</b></td><td>title RADIO · EACH TANK</td><td>rail key</td></tr>
      <tr><td>squad</td><td><b>RADIO</b> · WHOLE SQUAD</td><td><b>WHOLE SQUAD</b></td><td>WHOLE SQUAD</td><td>ORDERS · WHOLE SQUAD</td></tr>
      <tr><td>roster</td><td><b>PLATOON</b> · RADIOS</td><td><b>PLATOON</b></td><td><b>PLATOON</b></td><td>PLATOON</td></tr>
      <tr><td>aim</td><td><b>AIM</b> · AUTO / LOCK</td><td><b>AIM</b></td><td>title AIM</td><td>rail keys</td></tr>
    </tbody></table></div>
    <div class="bui bu-board bu-bar" data-bui>
      <div><span class="bui-label"><b>RADIO</b> · EACH TANK</span><button class="bui-key bui-arcade bui-cmd" type="button"><svg viewBox="0 0 20 20"><path d={icon.command}/></svg>Command<kbd>O</kbd></button></div>
      <i class="bu-sep"></i>
      <div><span class="bui-label"><b>RADIO</b> · WHOLE SQUAD</span><span class="bu-keys"><button class="bui-key bui-arcade bui-fallin" type="button"><svg viewBox="0 0 20 20"><path d={icon.fallin}/></svg>Fall in<kbd>F</kbd></button><button class="bui-key bui-arcade bui-retreat" type="button"><svg viewBox="0 0 20 20"><path d={icon.retreat}/></svg>Retreat<kbd>R</kbd></button></span></div>
      <div class="bu-center"><span class="bui-label"><b>PLATOON</b> · RADIOS</span><span class="bu-keys"><button class="bui-key bui-arcade bui-unit" type="button"><b>★</b><span class="bui-pips"><s></s><s></s></span></button><button class="bui-key bui-arcade bui-unit" type="button"><b>1</b><span class="bui-pips"><s></s></span></button><button class="bui-key bui-arcade bui-unit" type="button"><b>2</b><span class="bui-pips"><s></s><s></s><s></s></span></button></span></div>
      <div><span class="bui-label"><b>AIM</b> · AUTO / LOCK</span><span class="bu-keys"><button class="bui-key bui-arcade bui-aim" type="button" aria-pressed="true"><svg viewBox="0 0 20 20"><path d={icon.auto}/></svg>Auto<kbd>Q</kbd></button><button class="bui-key bui-arcade bui-aim" type="button"><svg viewBox="0 0 20 20"><path d={icon.lock}/></svg>Lock<kbd>T</kbd></button></span></div>
      <i class="bu-sep"></i>
      <button class="bui-key bui-arcade bui-flag" type="button"><svg viewBox="0 0 20 20"><path d={icon.flag}/></svg>Surrender</button>
    </div>
  </section>

  <!-- 06 CARDS -->
  <section id="cards" class="bu-block">
    <div class="bu-head"><span class="eyebrow"><span class="index">06</span> CARDS</span><h2>Float, fold, step back.</h2><p>Cards float over the field on the side away from your team. The grip drags them, the icon key shrinks them, the back tab goes one step back. A unit card's status pill sits on the top edge opposite the back tab, flat, breathing with the selected key's glow, in radio talk. Two cards never cover each other (10px buffer).</p></div>
    <div class="bui bu-board bu-cards" data-bui>
      <div class="bui-card bu-plan">
        <span class="bui-grip"></span>
        <button class="bui-back-tab" type="button"><svg viewBox="0 0 20 20"><path d={icon.back}/></svg>LOADOUT</button>
        <span class="bu-pill"><svg viewBox="0 0 20 20"><path d={icon.command}/></svg>ROGER · GRID 0412</span>
        <div class="bu-plan-body">
          <button class="bui-key bui-arcade bui-unit bu-big" type="button" aria-label="Shrink plan card"><b>2</b><span class="bui-pips"><s></s><s></s></span></button>
          <div><p class="bu-card-title">TANK 2 · MEDIUM</p><p class="bu-card-text">Pick an order beside the tank: Attack HQ, Follow, or Command.</p></div>
        </div>
      </div>
      <div class="bui-dock bu-dock">
        <span class="bui-dock-title">RADIO</span>
        <button class="bui-dock-switch" type="button" aria-label="Icons only"><svg viewBox="0 0 20 20"><path d={icon.list}/></svg></button>
        <span class="bui-label">EACH TANK</span>
