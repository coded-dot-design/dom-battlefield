<script>
  import { applyPalette, launch, slam, mount } from "../../../../vendor/fizlet/ui/board-ui";
  import kitCss from "../../../../vendor/fizlet/ui/board-ui.css?raw";
  const boards = [...document.querySelectorAll<HTMLElement>("[data-bui]")];
  const html = document.documentElement;
  const reduced = () => matchMedia("(prefers-reduced-motion: reduce)").matches;
  let boardTheme: "dark" | "light" = html.dataset.theme === "light" ? "light" : "dark";
  let restore: (() => void)[] = [];
  const chips = document.querySelector<HTMLElement>("[data-palettes]")!;
  const palettes = JSON.parse(chips.dataset.palettes!) as Record<string, Record<string, string>>;
  const custom: Record<string, string> = { sys: "#19f0ff", cmd: "#9a63ff", fire: "#ff2b4e", teamA: "#39ffb0", teamB: "#ff5c8f" };
  function paint(name: string) {
    restore.forEach((r) => r());
    const p = name === "custom" ? custom : palettes[name] ?? {};
    restore = boards.map((b) => applyPalette(b, p));
    for (const b of chips.querySelectorAll("button")) b.setAttribute("aria-pressed", String(b.dataset.palette === name));
    (document.querySelector(".bu-custom") as HTMLElement).hidden = name !== "custom";
    requestAnimationFrame(hexes);
  }
  function hexes() {
    const css = getComputedStyle(boards[0]!);
    for (const n of document.querySelectorAll<HTMLElement>("[data-hex]")) n.textContent = css.getPropertyValue(n.dataset.hex!).trim();
  }
  function theme(t: "dark" | "light") {
    boardTheme = t;
    for (const b of boards) b.dataset.theme = t;
    for (const b of document.querySelectorAll<HTMLElement>("[data-board-theme]")) b.setAttribute("aria-pressed", String(b.dataset.boardTheme === t));
    requestAnimationFrame(hexes);
  }
  for (const b of chips.querySelectorAll<HTMLElement>("button")) b.addEventListener("click", () => paint(b.dataset.palette!));
  for (const b of document.querySelectorAll<HTMLElement>("[data-board-theme]")) b.addEventListener("click", () => theme(b.dataset.boardTheme as "dark" | "light"));
  document.querySelector<HTMLElement>("[data-board-side]")!.addEventListener("click", (e) => {
    const on = (e.currentTarget as HTMLElement).getAttribute("aria-pressed") !== "true";
    (e.currentTarget as HTMLElement).setAttribute("aria-pressed", String(on));
    for (const b of boards) b.dataset.side = on ? "1" : "0";
  });
  for (const input of document.querySelectorAll<HTMLInputElement>("[data-custom]")) {
    input.value = custom[input.dataset.custom!]!;
    input.addEventListener("input", () => {
      custom[input.dataset.custom!] = input.value;
      paint("custom");
    });
  }
  // The site theme sets the board theme until a board theme is picked.
  new MutationObserver(() => theme(html.dataset.theme === "light" ? "light" : "dark")).observe(html, { attributes: true, attributeFilter: ["data-theme"] });
  theme(boardTheme);
  hexes();
  // Isolation: a board in a shadow root, under a hostile page rule (.bu-hostile button).
  const isoHost = document.querySelector<HTMLElement>("[data-shadow-demo]")!;
  const iso = mount(isoHost, kitCss, { theme: boardTheme });
  iso.style.cssText = "display:flex;flex-wrap:wrap;gap:8px;padding:18px;background:var(--bg);border-radius:12px";
  iso.innerHTML = `<button class="bui-key bui-arcade bui-fallin" type="button" aria-pressed="false">Fall in<kbd>F</kbd></button><button class="bui-key bui-arcade bui-attack" type="button" aria-pressed="false">Attack<kbd>G</kbd></button><button class="bui-key bui-arcade bui-cmd bui-call" type="button" aria-pressed="false">Command<kbd>O</kbd></button>`;
  for (const b of iso.querySelectorAll<HTMLElement>("button")) b.addEventListener("click", () => b.setAttribute("aria-pressed", String(b.getAttribute("aria-pressed") !== "true")));
  boards.push(iso);
  // Toggles: tap to lock, tap again to release (repaint in the handler: no bounce).
  for (const b of document.querySelectorAll<HTMLElement>("[data-toggle]"))
    b.addEventListener("click", () => b.setAttribute("aria-pressed", String(b.getAttribute("aria-pressed") !== "true")));
  for (const g of document.querySelectorAll<HTMLElement>("[data-seg]"))
    for (const b of g.querySelectorAll("button")) b.addEventListener("click", () => g.querySelectorAll("button").forEach((x) => x.setAttribute("aria-pressed", String(x === b))));
  // Overlay ritual.
  const overlay = document.querySelector<HTMLElement>("[data-overlay]")!;
  const open = () => {
    overlay.hidden = false;
    slam(overlay.querySelector(".bui-sticker"));
    overlay.querySelector<HTMLButtonElement>("button")?.focus({ preventScroll: true });
  };
  const close = () => (overlay.hidden = true);
  document.querySelector("[data-open-overlay]")!.addEventListener("click", open);
  document.querySelector("[data-close-overlay]")!.addEventListener("click", close);
  overlay.addEventListener("keydown", (e) => e.key === "Escape" && close());
  const flag = document.querySelector<HTMLButtonElement>("[data-surrender]")!;
  flag.addEventListener("click", () => {
    if (flag.classList.contains("go")) return;
    flag.classList.add("go");
    setTimeout(() => launch(flag, close, { reduced: reduced(), done: () => flag.classList.remove("go") }), reduced() ? 0 : 480);
  });
  for (const b of document.querySelectorAll<HTMLElement>("[data-launch]")) b.addEventListener("click", () => launch(b, () => {}, { reduced: reduced() }));
</script>

