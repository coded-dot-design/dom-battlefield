      <tr><td>Pause</td><td>BATTLE PAUSED / GIVE UP?</td><td>KEEP FIGHTING · SURRENDER</td></tr>
      <tr><td>Lost</td><td>INSERT COIN / GAME OVER</td><td>REMATCH · NEW CAMPAIGN</td></tr>
      <tr><td>Won</td><td>STAGE CLEAR / MISSION COMPLETE</td><td>REMATCH · NEW CAMPAIGN</td></tr>
