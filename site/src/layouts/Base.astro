---
// Every page: a Board UI root (<html class="bui">), so the page wears the game's own tokens.
// Theme is shared with the game and DOM VIRUS (localStorage "dom-virus:theme"), dark by default.
import '../../../board-ui/board-ui.css';
import '../styles/site.css';
import Icon from '../components/Icon.astro';
import Skull from '../components/Skull.astro';
import { VERSION, REPO, HUB, HUB_GAME, base } from '../site';
const { title, description, page = 'home' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const nav = [
  ['home', 'Game', base()],
  ['how', 'How it plays', base('#how')],
  ['blitz', 'Blitz', base('blitz/')],
  ['style', 'Style guide', base('style-guide/')],
];
---
<!doctype html>
<html lang="en" class="bui" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#07060f" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(base('shots/og.png'), Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href={base('play/icon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={base('play/icon-180.png')} />
    <script is:inline>
      try {
        var t = localStorage.getItem("dom-virus:theme");
        if (t === "light" || t === "dark") document.documentElement.dataset.theme = t;
      } catch (e) {}
    </script>
  </head>
  <body data-page={page}>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-head">
      <div class="wrap">
        <a class="brand" href={base()} aria-label="DOM Battlefield home">
          <span class="brand-mark"><Skull size={40} /></span>
          <span class="brand-text"><small>DOM<i>SOLO / V{VERSION}</i></small><b>BATTLEFIELD</b></span>
        </a>
        <nav class="site-nav" aria-label="Site">
          {nav.map(([id, label, href]) => <a href={href} aria-current={id === page ? 'page' : undefined}>{label}</a>)}
          <a href={HUB}>DOM VIRUS ↗</a>
        </nav>
        <div class="head-keys">
          <a class="bui-key bui-icon-key gh" href={REPO} aria-label="Source on GitHub"><Icon name="github" /></a>
          <button class="bui-icon-key" type="button" data-theme-toggle aria-label="Switch light or dark">
            <span class="theme-dark"><Icon name="moon" /></span><span class="theme-light"><Icon name="sun" /></span>
          </button>
          <a class="bui-key bui-arcade bui-go play-key" href={page === 'blitz' ? base('blitz/play/') : base('play/')} data-play><Icon name="play" size={16} />Play</a>
        </div>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-foot">
      <div class="wrap">
        <div class="foot-brand">
          <a class="brand" href={base()}>
            <span class="brand-mark"><Skull size={40} /></span>
            <span class="brand-text"><small>DOM</small><b>BATTLEFIELD</b></span>
          </a>
          <p>Squad tactics in a browser tab. A DOM VIRUS cartridge by coded.design: the page is the board.</p>
        </div>
        <div>
          <h4>GAME</h4>
          <ul>
            <li><a href={base('play/')}>Play now</a></li>
            <li><a href={base('#how')}>How it plays</a></li>
            <li><a href={base('blitz/')}>Battlefield Blitz</a></li>
            <li><a href={base('style-guide/')}>Board UI style guide</a></li>
            <li><a href={`${REPO}#readme`}>Release notes</a></li>
          </ul>
        </div>
        <div>
          <h4>DOM VIRUS</h4>
          <ul>
            <li><a href={HUB}>The arcade ↗</a></li>
            <li><a href={HUB_GAME}>Battlefield on the shelf ↗</a></li>
            <li><a href={REPO}>Source on GitHub ↗</a></li>
          </ul>
        </div>
      </div>
      <div class="foot-base">
        <div class="wrap"><span>© 2026 coded.design · MIT</span><span>Created by Chris Cooley</span></div>
      </div>
    </footer>
    <script>
      const html = document.documentElement;
      document.querySelector("[data-theme-toggle]")?.addEventListener("click", () => {
        const next = html.dataset.theme === "light" ? "dark" : "light";
        html.dataset.theme = next;
        try {
          localStorage.setItem("dom-virus:theme", next);
        } catch {}
      });
    </script>
  </body>
</html>
